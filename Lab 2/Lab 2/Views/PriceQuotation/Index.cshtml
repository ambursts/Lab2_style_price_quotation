@model Lab_2.Models.PriceQuotationModel



<header class="bg-success text-white text-center p-4 mb-4">
    <h1>Price Quotation</h1>
</header>

<div class="container">

<form method="post" action="/PriceQuotation/Index">

    <!-- Subtotal -->
    <div class="row mb-3">
        <label class="col-md-4 col-form-label">
            Subtotal:
        </label>
        <div class="col-md-4">
            <input name="Subtotal"
                   value="@Model.Subtotal"
                   class="form-control" />
        </div>
    </div>

        <!-- Discount Percent -->
        <div class="row mb-3">
            <label class="col-md-4 col-form-label">
                Discount Percent:
            </label>
            <div class="col-md-4">
                <input name="DiscountPercent"
                       value="@Model.DiscountPercent"
                       class="form-control" />
            </div>
        </div>

        <!-- Discount Amount -->
        <div class="row mb-2">
            <label class="col-md-4 col-form-label">
                Discount Amount:
            </label>
            <div class="col-md-4 pt-2">
                <strong>@Model.GetDiscountAmount().ToString("C")</strong>
            </div>
        </div>

        <!-- Total -->
        <div class="row mb-4">
            <label class="col-md-4 col-form-label">
                Total:
            </label>
            <div class="col-md-4 pt-2">
                <strong>@Model.GetTotal().ToString("C")</strong>
            </div>
        </div>    <!-- Buttons -->    
        <div class="row">       
            <div class="offset-md-4 col-md-4">  
                <button type="submit" class="btn btn-success">           
                    Calculate           
                    </button>




                <a href="/PriceQuotation/Index" class="btn btn-success ms-2">
                    Clear
                </a>


                    </div>   
                 </div>
    </form>
</div>


