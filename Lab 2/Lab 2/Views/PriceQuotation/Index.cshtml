@model Lab_2.Models.PriceQuotationModel

<header class="bg-success text-white text-center p-4 mb-4">
    <h1>
        <i class= "fas fa-money-bill-wave"> </i>
        Price Quotation
    </h1>
</header>

<div class="container">

<form method="post" action="/PriceQuotation/Index">

        <div class="row mb-3">
            <label class="col-md-4 col-form-label">
                Subtotal:
            </label>

            <div class="col-md-4">
                <input asp-for="Subtotal" class="form-control" />
            </div>

            <div class="col-md-4">
                <span asp-validation-for="Subtotal" class="text-danger"></span>
            </div>
        </div>
    
        <div class="row mb-3">
            <label class="col-md-4 col-form-label">
                Discount Percent:
            </label>

            <div class="col-md-4">
                <input asp-for="DiscountPercent" class="form-control" />
            </div>

            <div class="col-md-4">
                <span asp-validation-for="DiscountPercent" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-2">
            <label class="col-md-4 col-form-label">
                Discount Amount:
            </label>
            <div class="col-md-4 pt-2">
                <strong>@Model.GetDiscountAmount().ToString("C")</strong>
            </div>
        </div>

        <div class="row mb-4">
            <label class="col-md-4 col-form-label">
                Total:
            </label>
            <div class="col-md-4 pt-2">
                <strong>@Model.GetTotal().ToString("C")</strong>
            </div>
        </div>  
        
        <div class="row">       
            <div class="offset-md-4 col-md-4">  
                <button type="submit" class="btn btn-success">           
                    Calculate           
                    </button>
                <a href="/PriceQuotation/Index" class="btn btn-success ms-2">
                    Clear
                </a>
              </div>   
           </div>
    </form>
</div>


